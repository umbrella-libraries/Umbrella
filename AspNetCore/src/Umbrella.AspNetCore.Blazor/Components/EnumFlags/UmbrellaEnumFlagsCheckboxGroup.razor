@using Umbrella.AspNetCore.Blazor.Components.Checkbox
@typeparam TEnum
@inherits InputBase<TEnum>

<div class="u-enum-flags @CssClass">
    <ul class="u-enum-flags__items">
        @for (int i = 0; i < Options.Count; i++)
        {
            var option = Options.ElementAt(i);

            <li class="u-enum-flags__item">
                <UmbrellaCheckbox Value="option.IsSelected" ValueExpression="() => option.IsSelected" ValueChanged="() => OnOptionSelectionChanged(option)">
                    <span class="u-enum-flags__item-text">@option.Text</span>
                    @if (ShowDescriptions && !string.IsNullOrEmpty(option.Description))
                    {
                        <span class="u-enum-flags__item-description">@option.Description</span>
                    }
                </UmbrellaCheckbox>
            </li>
        }
    </ul>
</div>