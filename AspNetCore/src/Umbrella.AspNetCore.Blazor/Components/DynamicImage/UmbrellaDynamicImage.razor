@inherits Umbrella.AspNetCore.Blazor.Components.ResponsiveImage.UmbrellaResponsiveImage

@* Nothing is rendered until the source has been resolved. Blazor renders once before an incomplete OnParametersSetAsync completes, so an
   overridden resolver that performs I/O would otherwise emit an img with no src on that first pass. *@
@if (!string.IsNullOrEmpty(SrcValue))
{
    <picture class="u-dynamic-image @CssClass">
        @* Art directed sources are rendered first. Browsers use the first source with a matching media condition and a supported type, so the
           format sources below would otherwise win regardless of the media conditions declared on the children. *@
        @if (ChildContent is not null && Context is not null)
        {
            <CascadingValue Value="Context">
                @ChildContent
            </CascadingValue>
        }
        @foreach (DynamicImagePictureSource source in PictureSources)
        {
            <source type="@source.ContentType" srcset="@source.SrcSet" />
        }
        <img src="@SrcValue" srcset="@SrcSetValue" loading="@(LazyLoadingEnabled ? "lazy" : null)" decoding="@(LazyLoadingEnabled ? "async" : null)" @attributes="AdditionalAttributes" />
    </picture>
}
