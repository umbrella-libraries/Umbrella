@if (Model.TotalCount > 0)
{
	<nav class="u-pagination" aria-label="table navigation">
		<ul class="pagination @(SmallPagination ? "pagination-sm" : "")">
			@if (Model.PageNumbers.Count > 1)
			{
				<li class="page-item @(Model.FirstPageNumber.HasValue ? "" : "disabled")">
					<a class="page-link" href="@(Model.FirstPageNumber.HasValue ? BuildPageHref(Model.FirstPageNumber.Value) : null)" aria-label="First Page" aria-disabled="@(Model.FirstPageNumber.HasValue ? null : "true")" tabindex="@(Model.FirstPageNumber.HasValue ? null : "-1")" @onclick="FirstClickAsync" @onclick:preventDefault>
						<span aria-hidden="true">&laquo;</span>
					</a>
				</li>
				<li class="page-item @(Model.PreviousPageNumber.HasValue ? "" : "disabled")">
					<a class="page-link" href="@(Model.PreviousPageNumber.HasValue ? BuildPageHref(Model.PreviousPageNumber.Value) : null)" aria-label="Previous Page" aria-disabled="@(Model.PreviousPageNumber.HasValue ? null : "true")" tabindex="@(Model.PreviousPageNumber.HasValue ? null : "-1")" @onclick="PreviousClickAsync" @onclick:preventDefault>
						<span aria-hidden="true">&lsaquo;</span>
					</a>
				</li>
			}
			@foreach (var item in Model.PageNumbers)
			{
				<li class="page-item @(item.IsCurrentPage ? "active" : "")">
					<a class="page-link" href="@BuildPageHref(item.Number)" aria-label="Page @(item.Number)" aria-current="@(item.IsCurrentPage ? "page" : null)" @onclick="(e => ItemClickAsync(item.Number))" @onclick:preventDefault>@item.Number</a>
				</li>
			}
			@if (Model.PageNumbers.Count > 1)
			{
				<li class="page-item @(Model.NextPageNumber.HasValue ? "" : "disabled")">
					<a class="page-link" href="@(Model.NextPageNumber.HasValue ? BuildPageHref(Model.NextPageNumber.Value) : null)" aria-label="Next Page" aria-disabled="@(Model.NextPageNumber.HasValue ? null : "true")" tabindex="@(Model.NextPageNumber.HasValue ? null : "-1")" @onclick="NextClickAsync" @onclick:preventDefault>
						<span aria-hidden="true">&rsaquo;</span>
					</a>
				</li>
				<li class="page-item @(Model.LastPageNumber.HasValue ? "" : "disabled")">
					<a class="page-link" href="@(Model.LastPageNumber.HasValue ? BuildPageHref(Model.LastPageNumber.Value) : null)" aria-label="Last Page" aria-disabled="@(Model.LastPageNumber.HasValue ? null : "true")" tabindex="@(Model.LastPageNumber.HasValue ? null : "-1")" @onclick="LastClickAsync" @onclick:preventDefault>
						<span aria-hidden="true">&raquo;</span>
					</a>
				</li>
			}
		</ul>
		@if (ShowPageSizeOptions)
		{
			<div class="pagination-size">
				<div class="dropdown" role="menu">
					<a class="btn @(SmallPagination ? "btn-sm" : "") btn-primary dropdown-toggle" href="#" role="button" id="@PaginationSizeButtonId" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
						@PageSize
					</a>
					<div class="dropdown-menu" aria-labelledby="@PaginationSizeButtonId">
						@foreach (var option in PageSizeOptions)
						{
							<a class="dropdown-item @(option == PageSize ? "active" : "")" href="#" role="menuitem" @onclick="@(e => PageSizeClickAsync(option))" @onclick:preventDefault>@option</a>
						}
					</div>
				</div>
			</div>
		}
	</nav>
}
