{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://umbrella-libraries.github.io/ai/bundle-manifest.schema.json",
  "title": "AI bundle manifest",
  "type": "object",
  "required": [
    "bundleId",
    "bundleVersion",
    "installerPackageId",
    "installerVersion",
    "installedAt",
    "managedFiles",
    "managedBlocks",
    "managedMcpServers",
    "managedCodexMcp"
  ],
  "properties": {
    "bundleId": {
      "type": "string"
    },
    "bundleVersion": {
      "type": "string"
    },
    "installerPackageId": {
      "type": "string"
    },
    "installerVersion": {
      "type": "string"
    },
    "installedAt": {
      "type": "string",
      "format": "date-time"
    },
    "managedFiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pathHashRecord"
      }
    },
    "managedBlocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pathHashRecord"
      }
    },
    "managedMcpServers": {
      "description": "Canonical .mcp.json servers this bundle owns. The same server may appear in several bundle manifests when all owners describe it identically; it is deleted from .mcp.json only when the last owner is removed.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/nameHashRecord"
      }
    },
    "managedCodexMcp": {
      "description": "The shared Codex MCP region. 'path' is the region's file, always .codex/config.toml. 'hash' is this bundle's own contribution rendered in isolation, never the hash of the whole region, so another bundle installing or removing does not register as drift here.",
      "oneOf": [
        { "$ref": "#/$defs/pathHashRecord" },
        { "type": "null" }
      ]
    }
  },
  "$defs": {
    "pathHashRecord": {
      "type": "object",
      "required": [
        "path",
        "hash"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "hash": {
          "type": "string"
        }
      }
    },
    "nameHashRecord": {
      "type": "object",
      "required": [
        "name",
        "hash"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "hash": {
          "type": "string"
        }
      }
    }
  }
}
