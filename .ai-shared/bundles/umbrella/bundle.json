{
  "bundleId": "umbrella",
  "displayName": "Umbrella AI Skills and Agents",
  "catalogName": "Umbrella",
  "managedDirectories": [
    ".ai-shared\\bundles\\umbrella"
  ],
  "adapterDirectories": [
    {
      "source": ".ai-shared\\skills",
      "targets": [
        { "destination": ".claude\\skills", "substitutions": { "{{skill_dir}}": ".claude\\skills" } },
        { "destination": ".github\\skills", "substitutions": { "{{skill_dir}}": ".github\\skills" } },
        { "destination": ".agents\\skills", "substitutions": { "{{skill_dir}}": ".agents\\skills" } }
      ]
    },
    {
      "source": ".ai-shared\\agents\\claude",
      "targets": [{ "destination": ".claude\\agents" }]
    },
    {
      "source": ".ai-shared\\agents\\github",
      "targets": [{ "destination": ".github\\agents" }]
    }
  ],
  "skillListBlocks": [
    {
      "targetPath": ".ai-shared\\bundles\\umbrella\\blocks\\CLAUDE.block.md",
      "skillsDirectory": ".claude\\skills",
      "agentsDirectory": ".claude\\agents"
    },
    {
      "targetPath": ".ai-shared\\bundles\\umbrella\\blocks\\AGENTS.block.md",
      "skillsDirectory": ".agents\\skills",
      "agentsDirectory": ".claude\\agents"
    },
    {
      "targetPath": ".ai-shared\\bundles\\umbrella\\blocks\\copilot-instructions.block.md",
      "skillsDirectory": ".agents\\skills",
      "agentsDirectory": ".github\\agents"
    }
  ],
  "managedBlocks": [
    {
      "targetPath": "AGENTS.md",
      "sourcePath": ".ai-shared\\bundles\\umbrella\\blocks\\AGENTS.block.md"
    },
    {
      "targetPath": "CLAUDE.md",
      "sourcePath": ".ai-shared\\bundles\\umbrella\\blocks\\CLAUDE.block.md"
    },
    {
      "targetPath": ".github\\copilot-instructions.md",
      "sourcePath": ".ai-shared\\bundles\\umbrella\\blocks\\copilot-instructions.block.md"
    }
  ],
  "mcpSourcePath": ".mcp.json",
  "codexMcpServerOverrides": {
    "atlassian": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v2/mcp",
      "env_http_headers": {
        "Authorization": "ATLASSIAN_MCP_AUTH_HEADER"
      }
    },
    "ado-zinofi": {
      "type": "stdio",
      "command": "powershell",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-NonInteractive",
        "-Command",
        "if ([string]::IsNullOrWhiteSpace($env:ZINOFI_ADO_PAT)) { throw 'ZINOFI_ADO_PAT is not set' }; $credential = 'codex:' + $env:ZINOFI_ADO_PAT; $env:PERSONAL_ACCESS_TOKEN = [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes($credential)); Remove-Variable credential; & npx -y @azure-devops/mcp zinofi --authentication pat; exit $LASTEXITCODE"
      ],
      "env_vars": [
        "ZINOFI_ADO_PAT"
      ]
    },
    "ado-thrive": {
      "type": "stdio",
      "command": "powershell",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-NonInteractive",
        "-Command",
        "if ([string]::IsNullOrWhiteSpace($env:THRIVE_ADO_PAT)) { throw 'THRIVE_ADO_PAT is not set' }; $credential = 'codex:' + $env:THRIVE_ADO_PAT; $env:PERSONAL_ACCESS_TOKEN = [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes($credential)); Remove-Variable credential; & npx -y @azure-devops/mcp thriveforsend --authentication pat; exit $LASTEXITCODE"
      ],
      "env_vars": [
        "THRIVE_ADO_PAT"
      ]
    },
    "ado-remarkablexcp": {
      "type": "stdio",
      "command": "powershell",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-NonInteractive",
        "-Command",
        "if ([string]::IsNullOrWhiteSpace($env:REMARKABLEXCP_ADO_PAT)) { throw 'REMARKABLEXCP_ADO_PAT is not set' }; $credential = 'codex:' + $env:REMARKABLEXCP_ADO_PAT; $env:PERSONAL_ACCESS_TOKEN = [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes($credential)); Remove-Variable credential; & npx -y @azure-devops/mcp remarkablexcp --authentication pat; exit $LASTEXITCODE"
      ],
      "env_vars": [
        "REMARKABLEXCP_ADO_PAT"
      ]
    }
  },
  "starterFiles": [
    {
      "sourcePath": ".ai-shared\\bundles\\umbrella\\templates\\nuget-upgrade-exclusions.starter.json",
      "targetPath": "nuget-upgrade-exclusions.json"
    }
  ]
}
