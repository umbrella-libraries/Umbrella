{
  "bundleId": "umbrella",
  "displayName": "Umbrella AI Skills and Agents",
  "managedDirectories": [
    ".ai-shared\\bundles\\umbrella"
  ],
  "adapterDirectories": [
    {
      "source": ".ai-shared\\skills",
      "targets": [
        { "destination": ".claude\\skills", "substitutions": { "{{skill_dir}}": ".claude\\skills" } },
        { "destination": ".github\\skills", "substitutions": { "{{skill_dir}}": ".github\\skills" } },
        { "destination": ".agents\\skills", "substitutions": { "{{skill_dir}}": ".agents\\skills" } }
      ]
    },
    {
      "source": ".ai-shared\\agents\\claude",
      "targets": [{ "destination": ".claude\\agents" }]
    },
    {
      "source": ".ai-shared\\agents\\github",
      "targets": [{ "destination": ".github\\agents" }]
    }
  ],
  "skillListBlocks": [
    {
      "targetPath": ".ai-shared\\bundles\\umbrella\\blocks\\CLAUDE.block.md",
      "skillsDirectory": ".claude\\skills",
      "agentsDirectory": ".claude\\agents"
    },
    {
      "targetPath": ".ai-shared\\bundles\\umbrella\\blocks\\AGENTS.block.md",
      "skillsDirectory": ".agents\\skills",
      "agentsDirectory": ".claude\\agents"
    },
    {
      "targetPath": ".ai-shared\\bundles\\umbrella\\blocks\\copilot-instructions.block.md",
      "skillsDirectory": ".agents\\skills",
      "agentsDirectory": ".github\\agents"
    }
  ],
  "managedBlocks": [
    {
      "targetPath": "AGENTS.md",
      "sourcePath": ".ai-shared\\bundles\\umbrella\\blocks\\AGENTS.block.md"
    },
    {
      "targetPath": "CLAUDE.md",
      "sourcePath": ".ai-shared\\bundles\\umbrella\\blocks\\CLAUDE.block.md"
    },
    {
      "targetPath": ".github\\copilot-instructions.md",
      "sourcePath": ".ai-shared\\bundles\\umbrella\\blocks\\copilot-instructions.block.md"
    }
  ],
  "mcpSourcePath": ".mcp.json",
  "exclusionsStarterPath": ".ai-shared\\bundles\\umbrella\\templates\\nuget-upgrade-exclusions.starter.json"
}
