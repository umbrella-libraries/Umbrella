<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net8.0;net9.0;net10.0</TargetFrameworks>
	</PropertyGroup>

	<PropertyGroup>
		<PackageId>Umbrella.Utilities.Threading.Redis</PackageId>
		<Description>This package contains implementations of the threading interfaces under the Umbrella.Utilities.Threading namespace.</Description>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Umbrella.Utilities\Umbrella.Utilities.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="DistributedLock.Redis" Version="1.1.1" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\..\icon.png" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' Or '$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net9.0'">
		<PackageReference Include="StackExchange.Redis" Version="3.1.13" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="StackExchange.Redis" Version="3.0.17" />
	</ItemGroup>

</Project>
