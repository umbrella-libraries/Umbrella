<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<NoWarn>CS1591</NoWarn>
		<PreserveCompilationContext>true</PreserveCompilationContext>
		<UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
		<WarningsAsErrors>xUnit1051</WarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="CodeCoverage\**" />
		<Compile Remove="TestResults\**" />
		<EmbeddedResource Remove="CodeCoverage\**" />
		<EmbeddedResource Remove="TestResults\**" />
		<None Remove="CodeCoverage\**" />
		<None Remove="TestResults\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Moq" Version="4.20.72" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.3.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Umbrella.DataAccess.Analyzers\Umbrella.DataAccess.Analyzers.csproj" />
		<ProjectReference Include="..\Umbrella.Analyzers.Test.Shared\Umbrella.Analyzers.Test.Shared.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Xunit" />
		<Using Include="Umbrella.Analyzers.Test.Shared" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Update="Microsoft.Testing.Extensions.CodeCoverage" Version="18.8.0" />
	</ItemGroup>

</Project>
