<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
	</PropertyGroup>

	<PropertyGroup>
		<PackageId>Umbrella.Analyzers</PackageId>
		<Description>Roslyn analyzers that enforce global coding standards and model immutability for the Umbrella framework</Description>
		<DevelopmentDependency>true</DevelopmentDependency>
		<NoPackageAnalysis>true</NoPackageAnalysis>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all" />
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\..\..\Analyzers\analysis\ModelStandardsSymbolAnalysis.cs" Link="ModelStandardsSymbolAnalysis.cs" />
	</ItemGroup>

	<ItemGroup>
		<!-- Analyzer assets only. This assembly must never be packed into lib/ - it is a development
		     dependency and is stripped from publish output, so anything a consumer references from it
		     would fail to load at runtime. Consumer-facing attributes live in Umbrella.Analyzers.Abstractions. -->
		<None Include="bin\$(Configuration)\netstandard2.0\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="..\..\..\icon.png" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="System.Diagnostics.CodeAnalysis" />
	</ItemGroup>
	
</Project>
